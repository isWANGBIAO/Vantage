<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants><StartupObject>Vantage.Windows.Program</StartupObject><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms><RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>12</LangVersion>
    <ApplicationIcon>Assets/Vantage.ico</ApplicationIcon><EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" /><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" /><ProjectReference Include="../Vantage.Core/Vantage.Core.csproj" /></ItemGroup>
  <ItemGroup><Content Update="Assets/Vantage.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content></ItemGroup>
  <!-- Unpackaged MRT Core generates the app PRI but does not wire it into dotnet publish.
       Keep the generated identity/path; do not replace it with an empty or framework PRI.
       https://github.com/microsoft/WindowsAppSDK/issues/6720 -->
  <Target Name="PublishVantageProjectPri" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)" Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="'$(ProjectPriFullPath)' == '' Or !Exists('$(ProjectPriFullPath)')"
           Text="The generated Vantage application PRI is missing; native publish cannot continue." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
