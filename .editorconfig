# Keeps editors consistent with what the repository already uses. Files are
# UTF-8, LF, and two-space indented in JavaScript while Python and Markdown use
# four and two respectively.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab
